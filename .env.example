# Copia este archivo a .env.local para desarrollo local.
# En producción, define estas variables en el panel de tu hosting
# (Vercel / Netlify / Cloudflare Pages / GitHub Actions). Todas son OPCIONALES.
#
# Las variables con prefijo VITE_ se incluyen en el bundle del navegador:
# NUNCA pongas aquí claves secretas.

# Ruta base de la app. '/' en Vercel/Netlify/Cloudflare Pages;
# '/nombre-del-repo/' en GitHub Pages.
VITE_BASE_PATH=/

# Clave de localStorage donde se guardan los pasteles del usuario.
VITE_STORAGE_KEY=pastelchef_game_cakes_v2
